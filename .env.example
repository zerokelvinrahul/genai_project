# ChipGen AI Environment Configuration

# Google Gemini API Key
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Subprocess Execution Timeouts (seconds)
TIMEOUT_SIMULATION=30
TIMEOUT_SYNTHESIS=60

# Optional explicit paths if not in standard locations:
# IVERILOG_PATH=C:\iverilog\bin\iverilog.exe
# VVP_PATH=C:\iverilog\bin\vvp.exe
# YOSYS_PATH=E:\oss-cad-suite\bin\yosys.exe

